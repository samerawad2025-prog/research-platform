# Copy this file to .env.local and fill in your own values from
# Supabase -> Project Settings -> API. Never commit .env.local itself.
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Same Settings -> API page, the "service_role" secret,
# NOT the anon key. This bypasses all security rules, so it must only
# ever be set as a server-side environment variable, never with a
# NEXT_PUBLIC_ prefix, or it will be exposed to every visitor's browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Which AI provider handles extraction. "mock" costs nothing and needs
# no key, useful for testing. "gemini" is the live pilot provider.
AI_PROVIDER=mock

# Only needed when AI_PROVIDER=gemini. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to a current, stable Flash model if unset.
GEMINI_MODEL=gemini-2.5-flash
