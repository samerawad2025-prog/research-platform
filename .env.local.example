# Copy to .env.local (git-ignored) and fill in. Names and safe defaults
# only; never put a real key in this file. Full reference:
# docs/deployment.md.

# Supabase: client-safe values from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Only one Supabase project exists, so a real
# key here makes local runs write to the production database.
SUPABASE_SERVICE_ROLE_KEY=

# automatic | manual. Missing or anything else means manual: no document
# is sent to any AI provider and the researcher types the details.
EXTRACTION_MODE=manual

# Phase 3 M2A acceptance flow (off unless enabled; see docs/submission-flow.md).
# SUBMISSION_ACCEPTANCE_FLOW=enabled
# SUBMISSION_TOKEN_SECRET=   # 32+ random characters, server-only

# Phase 3 M4 protected review area (off unless enabled; docs/admin-review.md).
# Every /admin page and /api/admin route is 404 otherwise. Needs migration
# 0015, an Auth user bootstrapped as administrator, and sign-up disabled.
# ADMIN_REVIEW=enabled

# Used only in automatic mode. mock needs no key and makes no request.
AI_PROVIDER=mock
MOCK_SCENARIO=thesis

# Only when AI_PROVIDER=gemini. Production sets GEMINI_MODEL to
# gemini-3.5-flash-lite; the code default (gemini-3.6-flash) is stale.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MAX_OUTPUT_TOKENS=4096
# GEMINI_THINKING_LEVEL=low
# GEMINI_TIMEOUT_MS=45000
